# Frontend Environment Variables

# API URL (Backend)
VITE_API_URL=http://localhost:5000

# Google Analytics 4
# Get your Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=

# Meta (Facebook) Pixel
# Get your Pixel ID from: https://business.facebook.com/events_manager
# Format: numeric string (e.g., 1234567890123456)
VITE_META_PIXEL_ID=

# Enable analytics in development mode (optional)
# Set to 'true' to test analytics locally
VITE_ENABLE_ANALYTICS_DEV=false
